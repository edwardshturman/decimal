{
  "name": "decimal",
  "author": "Edward Shturman",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "A minimalist, web-based expense tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/edwardshturman/decimal.git"
  },
  "private": true,
  "scripts": {
    "predev": "bun install",
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "prebuild": "bun run lint && bun run format:check",
    "build": "next build --turbopack",
    "vercel-build": "prisma migrate deploy && bun run build",
    "start": "next start",
    "migrate:dev": "dotenv -e .env.local prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.production prisma migrate deploy",
    "refresh": "git pull && vc env pull"
  },
  "lint-staged": {
    "**/*": [
      "bun run lint",
      "bun run format:write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-roving-focus": "1.1.11",
    "@vercel/toolbar": "0.2.2",
    "cmdk": "1.1.1",
    "motion": "12.23.15",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.25",
    "plaid": "38.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-plaid-link": "4.1.1",
    "react-random-reveal": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "10.0.0",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "next-devtools-mcp": "0.3.10",
    "prettier": "3.6.2",
    "prisma": "7.8.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.x"
  }
}
